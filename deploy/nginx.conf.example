# /etc/nginx/conf.d/shotokan.conf
server {
    listen 80;
    server_name shotokan.hogberg.dev;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;               # nginx 1.25.1+ (older: listen 443 ssl http2;)
    server_name shotokan.hogberg.dev;
    ssl_certificate     /etc/letsencrypt/live/shotokan.hogberg.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shotokan.hogberg.dev/privkey.pem;

    # shared login while the site is private:  htpasswd -c /etc/nginx/shotokan.htpasswd <user>
    auth_basic "SHOTOKAN";
    auth_basic_user_file /etc/nginx/shotokan.htpasswd;
    add_header X-Robots-Tag "noindex" always;

    # Option A (systemd + venv): static files from disk, API on 8100
    root /srv/shotokan/web;
    location /_app/ { expires 30d; add_header Cache-Control "public, immutable"; }
    location /api/ { proxy_pass http://127.0.0.1:8100; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; }
    location /healthz { proxy_pass http://127.0.0.1:8100; auth_basic off; }
    location / { try_files $uri /index.html; }

    # Option B (Docker): the container serves everything; replace the four locations above with
    # location / { proxy_pass http://127.0.0.1:8100; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; }
}
